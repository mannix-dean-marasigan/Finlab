# FINLAB — frontend environment (copy to .env.local)
# Only PUBLIC client credentials belong here. Never put the service-role key
# in any VITE_ variable: everything prefixed VITE_ is shipped to the browser.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-public-key
